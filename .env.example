# --- Onezone (spaces, marketplace, user listing via Onezone API) ---
ONEDATA_ONEZONE_HOST=https://your-onezone.example
ONEDATA_ONEZONE_TOKEN=replace-with-onezone-token

# --- Oneprovider (files, attributes, transfers) ---
ONEDATA_ONEPROVIDER_HOST=https://your-oneprovider.example
ONEDATA_ONEPROVIDER_TOKEN=replace-with-oneprovider-token

# Set to "true" only for self-signed / broken TLS in dev (default: verify certificates).
# ONEDATA_ALLOW_INSECURE_TLS=false

# --- Optional: FastMCP / stdio logging ---
# FASTMCP_LOG_LEVEL=INFO
# FASTMCP_LOG_FILE=/tmp/onedata-mcp.log
